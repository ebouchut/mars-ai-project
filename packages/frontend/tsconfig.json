{
  // Visit https://aka.ms/tsconfig to read more about this file
  "include": ["src"],
  "compilerOptions": {
    // ~~~~~ File Layout

    // Directory containing the source .ts files
    "rootDir": "./src",
    // Directory where compiled .js files are emitted
    "outDir":  "./dist",

    // Base directory for resolving path aliases
    "baseUrl": "./src",

    // Path aliases: @/ maps to the src/ directory
    // @/components/Button.js ==> ./src/components/Button.js
    "paths": {
      "@/*": ["./*"]
    },

    // ~~~~~ Environment Settings

    // Emit modern ESNext module syntax; let Vite handle bundling and resolution
    "module": "ESNext",
    // Vite-recommended resolution strategy: allows extensionless imports,
    // models how a bundler resolves modules instead of Node.js resolution
    "moduleResolution": "Bundler",
    // Emit modern JS without downleveling syntax
    "target": "ESNext",
    // Use React 17+ automatic JSX transform (no need to import React in every file)
    "jsx": "react-jsx",

    // Include browser DOM APIs (document, window, HTMLElement, fetch, etc.)
    // alongside standard JS built-ins, required for React browser components
    "lib":   ["ESNext", "DOM", "DOM.Iterable"],

    // No global @types packages needed: DOM types come from "lib" above
    "types": [],

    // ~~~~~ Other Outputs

    // Generate .map files for debugger support
    "sourceMap":      true,
    // "declaration":    true,
    // "declarationMap": true,

    // ~~~~~ Stricter Typechecking Options

    // Force explicit undefined checks on indexed access
    "noUncheckedIndexedAccess": true,
    // Distinguish between optional and undefined properties
    "exactOptionalPropertyTypes": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // ~~~~~ Recommended Options

    // Enable all strict type-checking options
    "strict": true,
    // Preserve import/export syntax exactly as written
    "verbatimModuleSyntax": true,
    // Ensure each file can be transpiled independently
    "isolatedModules": true,
    // Warn on side-effect imports that resolve to nothing
    "noUncheckedSideEffectImports": true,
    // Treat every file as a module regardless of content
    "moduleDetection": "force",
    // Skip type checking of declaration files
    "skipLibCheck": true
  }
}
