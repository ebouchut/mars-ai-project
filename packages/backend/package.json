{
  "name": "@marsai/backend",
  "version": "1.0.0",
  "private": true,
  "description": "The backend of marsAI, a film festival Web application",
  "homepage": "https://github.com/ebouchut/mars-ai-project#readme",
  "bugs": {
    "url": "https://github.com/ebouchut/mars-ai-project/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ebouchut/mars-ai-project.git"
  },
  "scripts": {
    "dev": "nodemon",
    "start": "node dist/app.js",
    "build": "tsc && tsc-alias",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "docs": "typedoc"
  },
  "keywords": [],
  "author": "A-Team: https://github.com/ebouchut/mars-ai-project?tab=readme-ov-file#authors",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "dependencies": {
    "@marsai/database": "*",
    "@prisma/adapter-mariadb": "^7.3.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.12",
    "@types/nodemailer": "^7.0.9",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "nodemon": "^3.1.11",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  }
}
