generator client {
  // New Client code generator: https://www.prisma.io/docs/orm/prisma-schema/overview/generators#prisma-client
  provider = "prisma-client"

  // Where the Prisma Client code is generated
  output   = "../src/generated/prisma"

  // Prisma Client runs without the Rust query engine
  // and connects directly through a database driver adapter
  engineType = "client"
}

datasource db {
  provider = "mysql"
}

model Admin {
  id            Int      @id @default(autoincrement())
  email         String   @unique(map: "email") @db.VarChar(150)
  password_hash String   @db.VarChar(255)
  first_name    String   @db.VarChar(100)
  last_name     String   @db.VarChar(150)
  created_at    DateTime @db.Timestamp(0)
  updated_at    DateTime @default(now()) @db.Timestamp(0)

  @@map("admins")
}

model Award {
  id              Int             @id @default(autoincrement())
  partner_id      Int?
  name            String          @unique(map: "name") @db.VarChar(100)
  description     String?         @db.Text
  amount          Decimal?        @db.Decimal(10, 2)
  amount_currency AmountCurrency
  partner         Partner?        @relation(fields: [partner_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_awards_partners")
  nominations     Nomination[]
  votes           Vote[]

  @@index([partner_id], map: "fk_awards_partners")
  @@map("awards")
}

model FilmProductionTool {
  film_id            Int
  production_tool_id Int
  film               Film           @relation(fields: [film_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_film_production_tools_films")
  production_tool    ProductionTool @relation(fields: [production_tool_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_film_production_tools_production_tools")

  @@id([film_id, production_tool_id])
  @@index([production_tool_id], map: "fk_film_production_tools_production_tools")
  @@map("film_production_tools")
}

model Film {
  id                   Int                  @id @default(autoincrement())
  name                 String               @unique(map: "name") @db.VarChar(255)
  video_url            String               @db.VarChar(255)
  poster_url           String?              @db.VarChar(255)
  description          String?              @db.Text
  status               FilmStatus
  created_at           DateTime             @db.Timestamp(0)
  updated_at           DateTime             @default(now()) @db.Timestamp(0)
  film_production_tools FilmProductionTool[]
  nominations          Nomination[]
  screenings           Screening[]
  votes                Vote[]

  @@unique([name, video_url], map: "uk_films_name_video_url")
  @@index([status], map: "idx_films_status")
  @@map("films")
}

model JuryInvitation {
  id          Int       @id @default(autoincrement())
  email       String    @unique(map: "email") @db.VarChar(150)
  token       String    @db.VarChar(255)
  expires_at  DateTime  @db.Timestamp(0)
  accepted_at DateTime? @db.Timestamp(0)
  created_at  DateTime  @db.Timestamp(0)
  updated_at  DateTime  @default(now()) @db.Timestamp(0)

  @@index([token], map: "idx_jury_invitations_token")
  @@map("jury_invitations")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model NewsletterSubscription {
  id                Int                          @id @default(autoincrement())
  newsletter_id     Int?
  email             String?                      @unique(map: "email") @db.VarChar(150)
  status            NewsletterSubscriptionStatus
  subscribed_at     DateTime                     @db.Timestamp(0)
  esp_subscriber_id Int?
  esp_synced_at     DateTime?                    @db.Timestamp(0)
  esp_updated_at    DateTime?                    @db.Timestamp(0)
  created_at        DateTime                     @db.Timestamp(0)
  updated_at        DateTime                     @default(now()) @db.Timestamp(0)
  newsletter        Newsletter?                  @relation(fields: [newsletter_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "newsletters_registers_newsletter_subscriptions")

  @@index([status], map: "idx_newsletter_subscriptions_status")
  @@index([newsletter_id], map: "newsletters_registers_newsletter_subscriptions")
  @@map("newsletter_subscriptions")
}

model Newsletter {
  id                       Int                        @id @default(autoincrement())
  name                     String                     @unique(map: "name") @db.VarChar(150)
  last_published_at        DateTime?                  @db.Timestamp(0)
  created_at               DateTime                   @db.Timestamp(0)
  updated_at               DateTime                   @db.Timestamp(0)
  newsletter_subscriptions NewsletterSubscription[]

  @@map("newsletters")
}

model Nomination {
  film_id  Int
  award_id Int
  status   NominationStatus
  award    Award            @relation(fields: [award_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_nominations_awards")
  film     Film             @relation(fields: [film_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_nominations_films")

  @@id([film_id, award_id])
  @@index([award_id], map: "fk_nominations_awards")
  @@map("nominations")
}

model Partner {
  id            Int      @id @default(autoincrement())
  name          String?  @unique(map: "name") @db.VarChar(100)
  description   String?  @db.VarChar(255)
  url           String   @db.VarChar(255)
  logo          String   @db.VarChar(255)
  display_order Int?     @default(0)
  created_at    DateTime @db.Timestamp(0)
  updated_at    DateTime @default(now()) @db.Timestamp(0)
  awards        Award[]

  @@map("partners")
}

model ProductionTool {
  id                    Int                  @id @default(autoincrement())
  name                  String               @unique(map: "name") @db.VarChar(100)
  description           String?              @db.Text
  url                   String?              @db.VarChar(255)
  film_production_tools FilmProductionTool[]

  @@map("production_tools")
}

model Screening {
  user_id Int
  film_id Int
  status  ScreeningStatus
  comment String?         @db.Text
  film    Film            @relation(fields: [film_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_screenings_films")
  user    User            @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_screenings_users")

  @@id([user_id, film_id])
  @@index([film_id], map: "fk_screenings_films")
  @@map("screenings")
}

model SocialNetwork {
  id                   Int                  @id @default(autoincrement())
  name                 String               @db.VarChar(100)
  url                  String               @db.VarChar(255)
  user_social_networks UserSocialNetwork[]

  @@unique([name, url], map: "uk_social_networks_name_url")
  @@map("social_networks")
}

model UserSocialNetwork {
  user_id           Int
  social_network_id Int
  profile_url       String        @db.VarChar(255)
  social_network    SocialNetwork @relation(fields: [social_network_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_social_networks_social_networks")
  user              User          @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_social_networks_users")

  @@id([user_id, social_network_id])
  @@unique([user_id, social_network_id, profile_url], map: "uk_user_social_networks")
  @@index([social_network_id], map: "fk_user_social_networks_social_networks")
  @@map("user_social_networks")
}

model User {
  id                   Int                 @id @default(autoincrement())
  email                String              @unique(map: "email") @db.VarChar(150)
  password_hash        String              @db.VarChar(255)
  role                 UserRole
  first_name           String              @db.VarChar(60)
  last_name            String              @db.VarChar(255)
  bio                  String?             @db.Text
  photo                String?             @db.VarChar(255)
  created_at           DateTime?           @db.Timestamp(0)
  updated_at           DateTime            @default(now()) @db.Timestamp(0)
  screenings           Screening[]
  user_social_networks UserSocialNetwork[]
  votes                Vote[]
  works                Work[]

  @@map("users")
}

model Vote {
  id         Int      @id @default(autoincrement())
  user_id    Int
  film_id    Int
  award_id   Int
  score      Int
  comment    String   @db.Text
  created_at DateTime @db.Timestamp(0)
  updated_at DateTime @default(now()) @db.Timestamp(0)
  award      Award    @relation(fields: [award_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_votes_awards")
  film       Film     @relation(fields: [film_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_votes_films")
  user       User     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_votes_users")

  @@unique([user_id, film_id, award_id], map: "uk_votes_user_id_film_id_award_id")
  @@index([award_id], map: "fk_votes_awards")
  @@index([film_id], map: "fk_votes_films")
  @@map("votes")
}

model Work {
  id          Int       @id @default(autoincrement())
  user_id     Int
  date        DateTime? @db.Date
  name        String    @unique(map: "name") @db.VarChar(100)
  url         String    @unique(map: "url") @db.VarChar(255)
  description String?   @db.Text
  user        User      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_works_users")

  @@unique([name, url], map: "uk_works_name_url")
  @@index([user_id], map: "fk_works_users")
  @@map("works")
}

enum NominationStatus {
  nominated
  winner
  runner_up
  pending_tiebreak_consensus

  @@map("nominations_status")
}

enum ScreeningStatus {
  selected
  rejected
  pending_selection_consensus

  @@map("screenings_status")
}

enum NewsletterSubscriptionStatus {
  pending
  subscribed
  unsubscribed
  error

  @@map("newsletter_subscriptions_status")
}

enum UserRole {
  admin
  filmmaker
  screener
  jury

  @@map("users_role")
}

enum AmountCurrency {
  USD
  EUR

  @@map("awards_amount_currency")
}

enum FilmStatus {
  submitted
  bookended
  draft_published
  copyright_cleared
  copyright_flagged
  screenable
  screened
  pending_selection_consensus
  selected
  duration_exceeded
  rejected
  categorized
  in_competation
  scored

  @@map("films_status")
}
