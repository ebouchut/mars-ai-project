# .env.example
# This file is a template/example of the .env file for this project.
# It contains sensitive information (credentials, hostname, port number...)
#
# Usage:
#     cp .env.example .env
#     # Edit .env and adjust the configuration variables
#
# Warning:
#   Do NOT edit, nor commit .env file.

# Database Connection Configuration
#
DB_HOST=localhost
DB_PORT=3306
DB_USER=TODO_USERNAME_HERE
DB_PASSWORD=TODO_PASSWORD_HERE
DB_NAME=marsai


# Express Server Configuration
#
SERVER_PORT=3000
NODE_ENV=dev